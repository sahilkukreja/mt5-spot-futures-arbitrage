# OS
.DS_Store
__MACOSX/

# Claude Code local settings
.claude/settings.local.json

# Raw, unreviewed prior project dump — quarantined.
# Do NOT commit until content is manually reviewed and promoted (sanitized)
# into reference/legacy/SPOT-FUR-ARB-BOT/{source,configs,docs,samples}/.
# See reference/legacy/SPOT-FUR-ARB-BOT/README.md for the review policy.

# Compiled MT5 binaries and local terminal artifacts
*.ex5
*.dxvk-cache
*.dat

# measurement_harness/ run outputs -- transient, overwritten every run,
# never source of truth (see measurement_harness/README.md)
measurement_harness/*.csv
measurement_harness/*.log
measurement_harness/*.txt
measurement_harness/*.flag

# The account whitelist config must never live in the git working tree at
# all (see measurement_harness/README.md "Setup required" -- it belongs
# only in the terminal's own MQL5/Files/ sandbox). Named explicitly, not
# just caught by the *.txt rule above, in case that rule is ever narrowed.
measurement_harness/stage2_live_config.txt

# Broker/account exports and reports (contain the account number in the
# filename itself, plus the account holder's full real name and broker
# details in the content -- never committed, in any export format)
*.xlsx
ReportHistory-*
StatementReport-*
AccountStatement-*

# Archives (must be unpacked and reviewed before anything is committed)
*.zip

# Research data and notebooks output (large/binary; not source of truth)
!/research/.gitkeep

# Source-agnostic scratch
/src/*
!/src/.gitkeep

# Python virtual environments
.venv/
venv/
__pycache__/
*.pyc
