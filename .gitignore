# OS
.DS_Store
__MACOSX/

# Claude Code local settings
.claude/settings.local.json

# Raw, unreviewed prior project dump — quarantined.
# Do NOT commit until content is manually reviewed and promoted (sanitized)
# into reference/legacy/SPOT-FUR-ARB-BOT/{source,configs,docs,samples}/.
# See reference/legacy/SPOT-FUR-ARB-BOT/README.md for the review policy.

# Compiled MT5 binaries and local terminal artifacts
*.ex5
*.dxvk-cache
*.dat

# measurement_harness/ run outputs -- transient, overwritten every run,
# never source of truth (see measurement_harness/README.md)
measurement_harness/*.csv
measurement_harness/*.log

# Broker/account exports and reports (may contain account identifiers)
*.xlsx
ReportHistory-*.xlsx

# Archives (must be unpacked and reviewed before anything is committed)
*.zip

# Research data and notebooks output (large/binary; not source of truth)
!/research/.gitkeep

# Source-agnostic scratch
/src/*
!/src/.gitkeep

# Python virtual environments
.venv/
venv/
__pycache__/
*.pyc
